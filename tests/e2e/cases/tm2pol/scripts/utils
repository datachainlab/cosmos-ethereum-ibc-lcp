expectUnrelayedCount() {
    query_type=$1
    filter=".$2 | length"
    expect_count=$3
    unrelayed_count=$(${RLY} query ${query_type} ibc01 | jq "${filter}")
    if [ $unrelayed_count -ne ${expect_count} ]; then
        echo "$0 ${query_type}: expect=$expect_count, actual=$unrelayed_count"
        test -z "$RLY_PID" || kill $RLY_PID
        exit 1
    fi
}

waitUnrelayedCount() {
    query_type=$1
    chain=$2
    filter=".$chain | length"
    expect_count=$3
    timeout=$(( $(date +%s) + $4 ))
    unrelayed_count=999
    until [ $unrelayed_count -eq $expect_count ]; do
        unrelayed_count=$(${RLY} query ${query_type} ibc01 | jq "${filter}")
        date
        echo "$0 ${query_type}: expect=$expect_count, actual=$unrelayed_count"
        t=$(date +%s)
        if [ $t -gt $timeout ]; then
            echo "TIMEOUT waitUnrelayedCount: $query_type $chain expect $expect_count but $unrelayed_count"
            exit 1
        fi
        sleep 10
    done
}

# Kurtosis-pos prefunds only its admin account on bor's L2. Reuse the same key
# the hardhat deployer uses (see chains/polygon/contracts/hardhat.config.js).
POLYGON_SENDER_PRIVATE_KEY=${POLYGON_SENDER_PRIVATE_KEY:-0xd40311b5a5ca5eaeb48dfba5403bde4993ece8eccf4190e98e19fcd4754260ea}

sendPacketOnPol() {
    PATH_NAME=ibc01
    MOCKAPP_CONTRACT_B=$(cat $(dirname $0)/../../../chains/polygon/contracts/addresses/AppV1)
    # tm2pol's ibc-1.json doesn't wrap with the debug ChainConfig, so the rpc
    # address sits directly under `.chain.rpc_addr` (vs tm2eth's
    # `.chain.origin_chain.rpc_addr`).
    RPC_ADDRESS_B=$($RLY config show | jq -r '.chains[] | select(.chain.chain_id == "ibc1").chain.rpc_addr')
    PORT_B=$($RLY paths list --json | jq -r --arg path $PATH_NAME '.[$path].dst."port-id"')
    CHANNEL_B=$($RLY paths list --json | jq -r --arg path $PATH_NAME '.[$path].dst."channel-id"')

    SENDER=$(cast wallet address --private-key ${POLYGON_SENDER_PRIVATE_KEY})
    cast balance $SENDER --rpc-url $RPC_ADDRESS_B
    cast nonce $SENDER --rpc-url $RPC_ADDRESS_B
    cast send \
     --rpc-url $RPC_ADDRESS_B \
     --private-key ${POLYGON_SENDER_PRIVATE_KEY} \
     --legacy \
     $MOCKAPP_CONTRACT_B \
     'sendPacket(bytes,string,string,(uint64,uint64),uint64)' \
     $(cast from-utf8 'mock packet data') \
     $PORT_B \
     $CHANNEL_B \
     '(0,100000)' \
     $(date -d 1hour +%s%N) || exit 1
}
